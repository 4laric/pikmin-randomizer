     visual = re.search(r"^P2_BIGTREASURE_VISUAL_READY\s+clips=(\d+)\s+pellets=(\d+)\s+"
                        r"pellet_debug=(\d+)\s*$", text, flags=re.MULTILINE)
     if not visual:
