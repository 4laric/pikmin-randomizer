+    bool waitingForIK = false;
+    float stateTimer = 0.0f;
+
+    // Attack-pool ledger
+    bool poolStarted[P2BTWEAPON_Count] = {};
+    int poolInFlight[P2BTWEAPON_Count] = {};
+    int elecMaxNodes = 0;
