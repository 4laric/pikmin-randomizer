From 923b9443b438c7af3b3a87df7e43d530b6590474 Mon Sep 17 00:00:00 2001
From: 4laric <4laric@users.noreply.github.com>
Date: Mon, 14 Sep 2026 09:41:38 -0400
Subject: [PATCH 9/9] Waterwraith: group lane TUs in a static lib to keep the
 fixture link inline (#443)

---
 CMakeLists.txt | 24 +++++++++++++++++-------
 1 file changed, 17 insertions(+), 7 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 958b395b..cfe49fec 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -190,12 +190,6 @@ set(PC_PORT_SOURCES
     pc_port/pc_p2_mamuta.cpp
     pc_port/pc_p2_mamuta_rules.cpp
     pc_port/pc_p2_tank.cpp
-    pc_port/pc_p2_waterwraith.cpp
-    pc_port/pc_p2_waterwraith_visual.cpp
-    pc_port/pc_p2_waterwraith_host.cpp
-    pc_port/pc_p2_waterwraith_actor.cpp
-    pc_port/pc_p2_waterwraith_register.cpp
-    pc_port/pc_p2_waterwraith_encounter.cpp
     pc_port/pc_p2_qurione.cpp
     pc_port/pc_p2_kurage_receiver.cpp
     pc_port/pc_p2_sokkuri.cpp
@@ -432,7 +426,23 @@ add_executable(pikmin_pc
     ${PC_PORT_SOURCES}
 )
 target_compile_options(pikmin_pc PRIVATE ${NATIVE_COMPILE_OPTIONS})
-target_link_libraries(pikmin_pc PRIVATE pikmin_legacy)
+
+# Lane 31 (#443): keep the Waterwraith/Tyre TUs in their own static library.
+# Adding them directly pushes the pikmin_pc link over the Windows command-line
+# threshold, so CMake emits a response file that scripts/build_pikmin2_fixture.py
+# fails closed on (docs/PIKMIN2_FIXTURE_BUILDS.md). Grouping them here keeps the
+# executable link inline for the fixture-provenance tool.
+add_library(p2_waterwraith_lane31 STATIC
+    pc_port/pc_p2_waterwraith.cpp
+    pc_port/pc_p2_waterwraith_visual.cpp
+    pc_port/pc_p2_waterwraith_host.cpp
+    pc_port/pc_p2_waterwraith_actor.cpp
+    pc_port/pc_p2_waterwraith_register.cpp
+    pc_port/pc_p2_waterwraith_encounter.cpp
+)
+target_compile_options(p2_waterwraith_lane31 PRIVATE ${NATIVE_COMPILE_OPTIONS})
+
+target_link_libraries(pikmin_pc PRIVATE p2_waterwraith_lane31 pikmin_legacy)
 if(WIN32)
     add_library(bbft_transport STATIC pc_port/bbft/bbft_transport.c)
     target_link_libraries(pikmin_pc PRIVATE bbft_transport ws2_32)
-- 
2.55.0.windows.3

