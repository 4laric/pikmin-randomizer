@@ -226,6 +242,8 @@ void pc_p2_hardlanes_reset()
     p2_bigtreasure_host_reset(sBigTreasure);
     sBigTreasureOrdinary.reset(P2BigTreasureFsmParms());
     sBigTreasureClock.reset();
