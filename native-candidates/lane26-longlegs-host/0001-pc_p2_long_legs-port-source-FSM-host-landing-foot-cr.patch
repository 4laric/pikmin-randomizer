-        std::printf("P2_LONG_LEGS_BIND generator=%u species=%s pose=bind visual_only=1 native_fsm=unimplemented\n",
-                    entry.first->mGenerator ? entry.first->mGenerator->_70 : 0,
-                    entry.second.c_str());
