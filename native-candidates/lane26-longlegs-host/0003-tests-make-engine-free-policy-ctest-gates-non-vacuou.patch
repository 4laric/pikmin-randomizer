Date: Mon, 14 Sep 2026 09:02:17 -0400
Subject: [PATCH 3/7] tests: make engine-free policy ctest gates non-vacuous
 under NDEBUG (#173, #244, #376)

---
 CMakeLists.txt                        | 9 ++++++---
 tools/p2_bombsarai_blast_test.cpp     | 3 +++
 tools/p2_bombsarai_bomb_test.cpp      | 3 +++
 tools/p2_bombsarai_fsm_test.cpp       | 3 +++
 tools/p2_bombsarai_hover_test.cpp     | 3 +++
 tools/p2_bombsarai_induction_test.cpp | 8 +++++++-
 tools/p2_bombsarai_terrain_test.cpp   | 3 +++
 tools/p2_dangomushi_hazard_test.cpp   | 3 +++
 tools/p2_long_legs_fsm_test.cpp       | 3 +++
 tools/p2_snagret_fsm_test.cpp         | 3 +++
 10 files changed, 37 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 09cfdfdd..f0aaae41 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -752,9 +752,12 @@ target_include_directories(p2_bombsarai_terrain_test PRIVATE pc_port)
 target_compile_options(p2_bombsarai_terrain_test PRIVATE ${NATIVE_COMPILE_OPTIONS})
 add_test(NAME p2_bombsarai_terrain_test COMMAND p2_bombsarai_terrain_test)
 
-# Note: tools/p2_bombsarai_induction_test.cpp exists on the approved line but
-# does not terminate when run as a ctest (observed timeout at 15 s), so it is
-# intentionally not registered here. Tracked for lane 27 as a test-hang finding.
+add_executable(p2_bombsarai_induction_test
+    tools/p2_bombsarai_induction_test.cpp
+    pc_port/pc_p2_bombsarai_bomb.cpp)
+target_include_directories(p2_bombsarai_induction_test PRIVATE pc_port)
+target_compile_options(p2_bombsarai_induction_test PRIVATE ${NATIVE_COMPILE_OPTIONS})
+add_test(NAME p2_bombsarai_induction_test COMMAND p2_bombsarai_induction_test)
 
 add_executable(pc_render_phase_test
     pc_port/timing/pc_render_phase_test.cpp
diff --git a/tools/p2_bombsarai_blast_test.cpp b/tools/p2_bombsarai_blast_test.cpp
index e0938533..ea9dc150 100644
--- a/tools/p2_bombsarai_blast_test.cpp
+++ b/tools/p2_bombsarai_blast_test.cpp
@@ -1,5 +1,8 @@
 #include "pc_p2_bombsarai_blast.h"
 
+// Release builds pass -DNDEBUG; force assertions (and their embedded
+// side effects) on so this engine-free gate is not vacuous under ctest.
+#undef NDEBUG
 #include <cassert>
 #include <cmath>
 #include <limits>
