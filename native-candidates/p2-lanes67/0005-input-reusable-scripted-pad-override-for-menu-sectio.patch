 pc_port/pc_p2_input_script.cpp   | 58 ++++++++++++++++++++++++++++++++
 pc_port/pc_p2_input_script.h     | 19 +++++++++++
 src/sysDolphin/controllerMgr.cpp | 17 ++++++++++
 4 files changed, 95 insertions(+)
 create mode 100644 pc_port/pc_p2_input_script.cpp
